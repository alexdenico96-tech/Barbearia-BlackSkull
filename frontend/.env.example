# Copie para .env (desenvolvimento) ou configure em Settings > Environment Variables na Vercel.
# Variáveis VITE_* ficam visíveis no navegador: nunca coloque segredos aqui.

# URL da API (padrão: backend em produção). Para testar localmente:
# VITE_API_URL=http://localhost:3001/api
VITE_API_URL=https://barbearia-blackskull.onrender.com/api

# WhatsApp do barbeiro, só números com DDI+DDD (ex.: 5511999999999).
# Se preenchido, aparece o botão "Avisar no WhatsApp" após agendar.
VITE_WHATSAPP=

# Endpoint do Formspree para o aviso por e-mail (deixe vazio para usar mailto:)
# VITE_FORM_ENDPOINT=https://formspree.io/f/seu-id
# VITE_EMAIL_BARBEIRO=barbeiro@blackskull.com
