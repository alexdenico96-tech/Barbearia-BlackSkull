# Copie para .env (desenvolvimento) ou configure no painel do Render (produção).
# Observação: o servidor NÃO lê o arquivo .env sozinho; no Render use "Environment".
# Em desenvolvimento local você pode rodar:  node --env-file=.env index.js

# OBRIGATÓRIO em produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Caminho do banco. No Render com Disk montado em /var/data:
# DB_PATH=/var/data/barbearia.db

# Backups automáticos (padrão: ligado, guarda os últimos 7 dias)
# BACKUP_ENABLED=true
# BACKUP_KEEP=7

# Regras de agendamento (valores padrão mostrados)
# TIMEZONE=America/Sao_Paulo
# OPEN_TIME=09:00
# CLOSE_TIME=19:00
# SLOT_MINUTES=30
# BUSINESS_DAYS=1,2,3,4,5,6     # 0=domingo ... 6=sábado
# MAX_ADVANCE_DAYS=60
# MIN_NOTICE_MINUTES=0
